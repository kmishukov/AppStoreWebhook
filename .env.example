# Docker image version used by Docker Compose, for example 1.1.1 or latest.
APPSTORE_WEBHOOK_VERSION=latest

TELEGRAM_CHAT_ID=123456789
TOKEN=your-telegram-bot-token

# IANA timezone used in Telegram messages.
TIMEZONE=America/New_York

# Comma-separated: Production, Sandbox, or both.
APPLE_ENVIRONMENTS=Production,Sandbox

# Verify Apple certificate revocation status via OCSP.
APPLE_ENABLE_ONLINE_CHECKS=true

# Optional JSON allowlist. When omitted, any correctly signed Apple app is accepted.
# APPLE_ALLOWED_APPS={"com.example.first":1234567890,"com.example.second":2345678901}
